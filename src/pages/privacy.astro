---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Privacy | ${site.name}`} description="How we handle your information.">
  <section><div class="wrap prose">
    <h1>Privacy</h1>
    <p>When you send an enquiry, we collect your name, phone number, email (if you give it), the program you are interested in, and how you found us. We use this only to counsel you about programs and to help you apply.</p>
    <p>We may contact you by phone, WhatsApp, SMS or email. Calls and chats may be handled or assisted by AI and may be recorded for quality. You can ask us to stop contacting you or to delete your data at any time.</p>
    <p>When you apply, we share your details with the university you choose. We do not sell your data.</p>
  </div></section>
</Base>
