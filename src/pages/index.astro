---
import Base from '../layouts/Base.astro';
import { regionList } from '../data/regions';
import { programs, universities } from '../data/catalog';
import { site, url } from '../data/site';
import Pic from '../components/Pic.astro';
import SearchBar from '../components/SearchBar.astro';
import { regionImg, heroImg, HERO_WIDTHS } from '../data/images';
---
<Base title={`${site.name}: Compare UGC-entitled online degrees from Indian universities`} description={`${site.tagline}. ${programs.length} online programs from ${Object.keys(universities).length} universities, with free counselling.`} region="in">
  <div class="hero hero-bg">
    <Pic img={heroImg.home} widths={HERO_WIDTHS} ratio={2.2} sizes="(min-width: 900px) 58vw, 100vw" priority />
    <div class="wrap"><div class="copy">
    <h1>{site.tagline}</h1>
    <SearchBar />
    <!-- The Worker (worker/index.ts) fills in the visitor's region from their country; the script below covers previews and local runs. -->
    <p class="geo small muted">Fees and counselling for <b data-geo-label>your region</b> · <a href="#regions">Change</a></p>
    </div></div>
  </div>
  <section id="regions"><div class="wrap">
    <h2>Where are you studying from?</h2>
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))">{regionList.map((r) => <a class="card media" style="text-decoration:none;color:inherit" href={url(`/${r.id}/`)}><Pic img={regionImg[r.id]} sizes="(min-width: 900px) 360px, 100vw" /><div class="body"><h3>{r.label}</h3><p class="small muted" style="margin:0">{r.hero}</p></div></a>)}</div>
  </div></section>
  <script>
    // Fallback when the Worker didn't set the region (local runs): guess from the browser time zone. No redirect, so crawlers see the same page.
    import { regionLabels, regionNames, regionForTz } from '../data/geo';
    const box = document.querySelector<HTMLElement>('[data-search]');
    const label = document.querySelector<HTMLElement>('[data-geo-label]');
    if (box && label && box.dataset.region === 'auto') {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      const id = regionForTz(tz);
      label.textContent = regionLabels[id];
      const n = document.querySelector('[data-geo-name]'); if (n) n.textContent = regionNames[id];
      document.querySelectorAll('.region-switch a').forEach((a) => a.getAttribute('href')?.endsWith(`/${id}/`) ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'));
    }
  </script>
</Base>
