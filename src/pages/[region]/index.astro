---
import Base from '../../layouts/Base.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import Faq from '../../components/Faq.astro';
import { regionList, regions, type RegionId } from '../../data/regions';
import { programs, degrees, degreeInfo, byDegree, universities } from '../../data/catalog';
import { url, site } from '../../data/site';
import { faqLd, fitTitle, clipDesc } from '../../lib';
import Pic from '../../components/Pic.astro';
import { regionImg, imgForDegree, heroImg, HERO_WIDTHS } from '../../data/images';
export const getStaticPaths = () => regionList.map((r) => ({ params: { region: r.id } }));
const r = regions[Astro.params.region as RegionId];
const featured = ['MBA', 'MCA', 'BBA', 'BCA'].flatMap((d) => byDegree(d).filter((p, i, a) => a.findIndex((x) => x.university === p.university) === i).slice(0, 2));
---
<Base title={fitTitle(`Online Degrees for ${r.label}: MBA, MCA, BBA, BCA | ${site.name}`, `Online Degrees for ${r.label}: MBA, MCA, BBA, BCA`)} description={clipDesc(r.sub)} region={r.id} regionPath="/" image={heroImg[r.id]} jsonld={[faqLd(r.faqs)]}>
  <div class="hero hero-bg">
    <Pic img={heroImg[r.id]} widths={HERO_WIDTHS} ratio={2.2} sizes="(min-width: 900px) 58vw, 100vw" priority />
    <div class="wrap"><div class="copy">
      <h1>{r.hero}</h1>
      <p>{r.sub}</p>
      <div class="row"><a class="btn" href={url(`/${r.id}/programs/`)}>Browse {programs.length} programs</a><a class="btn alt" href="#counselling">Talk to an advisor</a></div>
    </div></div>
  </div>
  <section><div class="wrap">
    <div class="grid">{r.points.map((p) => <div class="card"><h3>{p.title}</h3><p class="small muted" style="margin:0">{p.body}</p></div>)}</div>
  </div></section>
  <section><div class="wrap">
    <h2>Popular programs</h2>
    <div class="grid">{featured.map((p) => <ProgramCard p={p} region={r} />)}</div>
  </div></section>
  <section><div class="wrap">
    <h2>Browse by degree</h2>
    <div class="grid">{degrees.map((d) => <a class="card media" style="text-decoration:none;color:inherit" href={url(`/${r.id}/online-${d.toLowerCase()}/`)}><Pic img={imgForDegree(d)} alt="" sizes="(min-width: 900px) 360px, 100vw" /><div class="body"><h3>Online {d}</h3><p class="small muted" style="margin:0">{degreeInfo[d].full} · {byDegree(d).length} programs</p></div></a>)}</div>
  </div></section>
  <section><div class="wrap">
    <h2>Universities</h2>
    <div class="grid">{Object.values(universities).map((u) => <a class="card" style="text-decoration:none;color:inherit" href={url(`/${r.id}/universities/${u.id}/`)}><h3>{u.name}</h3><p class="small muted" style="margin:0 0 6px">{u.city} · Est. {u.est}</p>{u.approvals.slice(0, 3).map((a) => <span class="tag">{a}</span>)}</a>)}</div>
  </div></section>
  <section id="counselling"><div class="wrap layout-2">
    <div><h2>Questions students ask</h2><Faq faqs={r.faqs} /></div>
    <div class="card sticky"><h3>Get free counselling</h3><p class="small muted">Tell us what you want to study. An advisor will reply on WhatsApp or call you during {r.hours}.</p><LeadForm region={r.id} /></div>
  </div></section>
</Base>
