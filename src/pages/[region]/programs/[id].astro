---
import Base from '../../../layouts/Base.astro';
import LeadForm from '../../../components/LeadForm.astro';
import ProgramCard from '../../../components/ProgramCard.astro';
import Faq from '../../../components/Faq.astro';
import { regionList, regions, type RegionId } from '../../../data/regions';
import { programs, uni, feeFor, degreeInfo, type Program } from '../../../data/catalog';
import { url, site } from '../../../data/site';
import { faqLd, crumbLd, fitTitle, clipDesc } from '../../../lib';
import { imgForDegree } from '../../../data/images';
export const getStaticPaths = () => regionList.flatMap((r) => programs.map((p) => ({ params: { region: r.id, id: p.id }, props: { p } })));
const { p } = Astro.props as { p: Program };
const r = regions[Astro.params.region as RegionId];
const u = uni(p);
const dur = p.duration_years ? `${p.duration_years} year${p.duration_years > 1 ? 's' : ''}` : 'Ask an advisor';
const f = feeFor(p, r.id);
const fee = f ? f.long : r.id === 'in' ? 'Ask an advisor for the current fee' : 'Ask an advisor for the international fee in your currency';
const info = degreeInfo[p.degree];
const faqs = [
  { q: `Is the ${p.name} from ${u.name} valid?`, a: `${u.name} states that it holds these approvals: ${u.approvals.join(', ')}. Degrees from UGC-entitled universities earned online are treated as equivalent to on-campus degrees. Check the university’s current entitlement on the UGC-DEB website before enrolling.` },
  { q: `Who can apply for the ${p.name}?`, a: `Applicants in India: ${p.eligibility_india}. International applicants: ${p.eligibility_foreign}.` },
  { q: `How much does the ${p.name} from ${u.name} cost?`, a: f ? `${f.long} Fees can change, so confirm the current amount with an advisor before paying.` : `${u.name} has not published this fee for your region. An advisor can confirm the current fee and payment options.` },
  ...(r.id !== 'in' ? [{ q: `Can I study the ${p.name} from ${r.name === 'International' ? 'outside India' : r.name}?`, a: `Yes. Classes, assignments and exams are online, so you do not need to travel to India. ${r.id === 'me' ? 'If you need the degree attested or evaluated in a Gulf country, check the rules for your country before you enrol.' : 'Check how your country or employer recognises Indian online degrees before you enrol.'}` }] : []),
  { q: 'How are exams held?', a: u.exams + '.' },
  { q: 'How long does it take?', a: `The program normally takes ${dur}.${p.credits ? ` It carries ${p.credits} credits.` : ''}` },
];
const self = new URL(Astro.url.pathname, Astro.site).href;
// Offers carry only published, confirmed fees: the India total from a university fee notification.
// Universities whose fees are under revision (fee_note) and all international/regional tuition stay out until confirmed.
const offers = r.id === 'in' && p.fee_inr && !u.fee_note
  ? { '@type': 'Offer', category: 'Paid', price: p.fee_inr, priceCurrency: 'INR', url: self, description: `Total program fee for students in India${p.fee_per_year_inr ? ` (₹${p.fee_per_year_inr.toLocaleString('en-IN')} per year)` : ''}` }
  : undefined;
const provider = { '@type': 'CollegeOrUniversity', name: u.name, address: { '@type': 'PostalAddress', addressLocality: u.city, addressCountry: 'IN' } };
const credential = { '@type': 'EducationalOccupationalCredential', name: info?.full || p.degree, credentialCategory: /Diploma|PGD|DCA/.test(p.level + p.degree) ? 'diploma' : 'degree', recognizedBy: { '@type': 'Organization', name: 'University Grants Commission (UGC)' } };
const course = {
  '@context': 'https://schema.org', '@type': 'EducationalOccupationalProgram',
  name: `${p.name} – ${u.name}`, url: self, programType: 'online', educationalProgramMode: 'online',
  identifier: p.id, provider,
  timeToComplete: p.duration_years ? `P${p.duration_years}Y` : undefined,
  numberOfCredits: p.credits ?? undefined,
  educationalCredentialAwarded: credential, occupationalCredentialAwarded: credential,
  programPrerequisites: r.id === 'in' ? p.eligibility_india : p.eligibility_foreign,
  ...(p.terms ? { termsPerYear: Math.round(p.terms / (p.duration_years || 1)) } : {}),
  ...(offers ? { offers } : {}),
};
// A plain Course object alongside the program, so search and AI engines that only read Course still pick it up.
const courseLd = {
  '@context': 'https://schema.org', '@type': 'Course', name: `${p.name} (${u.name})`, url: self, courseCode: p.id.toUpperCase(),
  description: `${p.name} from ${u.name}: ${dur}, ${p.level}, taught 100% online. Eligibility: ${r.id === 'in' ? p.eligibility_india : p.eligibility_foreign}.`,
  provider, educationalCredentialAwarded: credential.name, inLanguage: 'en',
  ...(p.duration_years ? { timeRequired: `P${p.duration_years}Y` } : {}),
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', ...(p.duration_years ? { courseWorkload: `P${p.duration_years}Y` } : {}) },
  ...(offers ? { offers } : {}),
};
// Answer-first summary: the sentence an AI answer or a featured snippet can quote as is.
const levelWord = { UG: 'undergraduate', PG: 'postgraduate', 'PG Diploma': 'postgraduate diploma', Diploma: 'diploma' }[p.level] || p.level;
const summary = `${p.name} from ${u.name} is a ${p.duration_years ? p.duration_years + '-year ' : ''}${levelWord} program taught fully online. Exams: ${u.exams.charAt(0).toLowerCase() + u.exams.slice(1)}. ${f ? 'Fee: ' + f.short + '.' : 'Ask an advisor for the current fee.'} Eligibility: ${r.id === 'in' ? p.eligibility_india : p.eligibility_foreign}.`;
const related = programs.filter((x) => x.degree === p.degree && x.id !== p.id).slice(0, 6);
---
<Base title={fitTitle(`${p.name}, ${u.short}: Fees & Eligibility (${r.tag}) | ${site.name}`, `${p.name}, ${u.short}: Fees & Eligibility (${r.tag})`, `${p.name}, ${u.short} (${r.tag})`)} description={clipDesc(`${p.name} from ${u.name} for ${r.audience}: ${dur}${f ? `, ${f.short}` : ''}. Eligibility, exams, approvals (${u.approvals.slice(0, 2).join(', ')}) and free counselling.`)} region={r.id} regionPath={`/programs/${p.id}/`} image={imgForDegree(p.degree)} jsonld={[course, courseLd, faqLd(faqs), crumbLd([['Programs', new URL(url(`/${r.id}/programs/`), Astro.site).href], [p.name, self]])]}>
  <div class="wrap crumbs"><a href={url(`/${r.id}/programs/`)}>Programs</a> › <a href={url(`/${r.id}/online-${p.degree.toLowerCase()}/`)}>Online {p.degree}</a> › {p.name}</div>
  <section><div class="wrap layout-2">
    <div>
      <h1 style="margin-top:0">{p.name}</h1>
      <p class="answer"><strong>In short:</strong> {summary}</p>
      <p class="muted">Offered by <a href={url(`/${r.id}/universities/${u.id}/`)}>{u.name}</a>, {u.city}. {info?.blurb}</p>
      <table class="facts">
        <tr><th>Level</th><td>{p.level}</td></tr>
        <tr><th>Duration</th><td>{dur}</td></tr>
        {p.credits && <tr><th>Credits</th><td>{p.credits}</td></tr>}
        <tr><th>Fee</th><td>{fee}{u.other_fees && <><br /><span class="small muted">{u.other_fees}.</span></>}{p.fee_source && <><br /><span class="small muted">Source: {p.fee_source}. Confirm with an advisor before paying.</span></>}</td></tr>
        {p.specializations.length > 0 && <tr><th>Specialisations / electives</th><td>{p.specializations.join(', ')}</td></tr>}
        <tr><th>Eligibility (India)</th><td>{p.eligibility_india}</td></tr>
        <tr><th>Eligibility (international)</th><td>{p.eligibility_foreign}</td></tr>
        <tr><th>Mode</th><td>100% online</td></tr>
        <tr><th>Exams</th><td>{u.exams}</td></tr>
        <tr><th>Approvals (as stated by the university)</th><td>{u.approvals.join(', ')}</td></tr>
        {u.scholarships && <tr><th>Scholarships</th><td>{Object.entries(u.scholarships).map(([k, v]) => `${k}: ${v}%`).join(' · ')} (confirm eligibility with an advisor)</td></tr>}
      </table>
      <h2 style="margin-top:28px">How admission works</h2>
      <ol>
        <li>Talk to an advisor (free) to confirm the program fits your goals and eligibility.</li>
        <li>Apply online and upload your mark sheets, ID and photo.</li>
        <li>Pay the fee to the university in full, per semester or by EMI where offered.</li>
        <li>The university verifies your documents and confirms enrolment.</li>
        <li>You get access to the learning platform and start classes.</li>
      </ol>
      <h2>FAQs</h2>
      <Faq faqs={faqs} />
    </div>
    <aside><div class="card sticky">
      <h3>Interested in this program?</h3>
      <p class="small muted">Get the current fee, intake dates and a free eligibility check.</p>
      <LeadForm region={r.id} program={p.id} />
    </div></aside>
  </div></section>
  {related.length > 0 && <section><div class="wrap"><h2>Compare other {p.degree} programs</h2><div class="grid">{related.map((x) => <ProgramCard p={x} region={r} />)}</div></div></section>}
</Base>
