---
import Base from './Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, url } from '../data/site';
import Pic from '../components/Pic.astro';
import { articleImg } from '../data/images';
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() || '';
const hero = articleImg[slug];
const { frontmatter } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'Article', headline: frontmatter.title, description: frontmatter.description, datePublished: frontmatter.date, dateModified: frontmatter.updated || frontmatter.date, author: { '@type': 'Organization', name: `${site.name} Advisors` }, publisher: { '@type': 'Organization', name: site.name }, ...(hero ? { image: new URL(url(`/img/${hero.name}-1280.webp`), Astro.site).href } : {}) };
---
<Base title={`${frontmatter.title} | ${site.name}`} description={frontmatter.description} jsonld={[ld]} image={hero}>
  <div class="wrap crumbs"><a href={url('/articles/')}>Guides</a> › {frontmatter.title}</div>
  <section><div class="wrap layout-2">
    <article class="prose">
      <h1 style="margin-top:0">{frontmatter.title}</h1>
      <p class="small muted">Updated {frontmatter.updated || frontmatter.date} · {site.name} Advisors</p>
      {hero && <Pic img={hero} class="art-img" sizes="(min-width: 900px) 700px, 100vw" priority />}
      <slot />
    </article>
    <aside><div class="card sticky"><h3>Have a question?</h3><p class="small muted">Ask an advisor. It’s free.</p><LeadForm region="in" /></div></aside>
  </div></section>
</Base>
