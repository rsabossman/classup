---
import '../styles/global.css';
import { site, url } from '../data/site';
import { regions, regionList, type RegionId } from '../data/regions';
import { heroImg, type Img } from '../data/images';
import Attribution from '../components/Attribution.astro';
import Gtm from '../components/Gtm.astro';
interface Props { title: string; description: string; region?: RegionId; jsonld?: object[]; regionPath?: string; image?: Img }
const { title, description, region = 'in', jsonld = [], regionPath = '', image = heroImg.home } = Astro.props;
const ogW = image.ogWidth ?? 1280;
const ogImage = new URL(url(`/img/${image.name}-${ogW}.webp`), Astro.site).href;
const r = regions[region];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(url('/'), Astro.site).href;
const org = [
  { '@context': 'https://schema.org', '@type': ['Organization', 'EducationalOrganization'], '@id': home + '#org', name: site.name, alternateName: site.alternateNames, url: home,
    logo: { '@type': 'ImageObject', url: new URL(url('/logo-512.png'), Astro.site).href, width: 512, height: 512 },
    image: new URL(url('/logo-512.png'), Astro.site).href,
    description: site.descriptor, disambiguatingDescription: site.disambiguation, slogan: site.tagline,
    address: { '@type': 'PostalAddress', addressCountry: 'IN' },
    contactPoint: { '@type': 'ContactPoint', contactType: 'admissions counselling', telephone: '+91-80-6426-4489', availableLanguage: ['English'], areaServed: 'Worldwide' },
    areaServed: regionList.flatMap((x) => x.hreflang).filter((h) => h.includes('-')).map((h) => h.split('-')[1]),
    sameAs: site.social.map((x) => x.href),
    knowsAbout: ['Online degrees in India', 'UGC-entitled online programs', 'Online MBA', 'Online MCA', 'Online BBA', 'Online BCA', 'Online BCom', 'Online MCom', 'Online MA'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': home + '#site', name: site.name, url: home, publisher: { '@id': home + '#org' }, inLanguage: 'en',
    // The homepage search box reads ?q= on load, so agents can link straight to a search.
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: home + '?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
];
// Each regional copy of a page names every country it serves; the international copy is the fallback (x-default).
const alternates = regionPath ? [
  ...regionList.flatMap((x) => x.hreflang.map((h) => ({ hreflang: h, href: new URL(url(`/${x.id}${regionPath}`), Astro.site).href }))),
  { hreflang: 'x-default', href: new URL(url(`/intl${regionPath}`), Astro.site).href },
] : [];
const icon: Record<string, string> = {
  Facebook: 'M14 8.5V6.8c0-.8.5-1 .9-1H17V2.1L14.1 2C10.9 2 10.2 4.4 10.2 6v2.5H8V12h2.2v10H14V12h2.8l.4-3.5z',
  Instagram: 'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm4.9-8.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM12 3.6c2.7 0 3 0 4.1.1 2.7.1 4 1.4 4.1 4.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 2.7-1.4 4-4.1 4.1-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1.1-.1-1.4-.1-4.1s0-3 .1-4.1c.1-2.7 1.4-4 4.1-4.1 1.1-.1 1.4-.1 4.1-.1zM12 2c-2.7 0-3.1 0-4.1.1C4.2 2.2 2.2 4.2 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.2 3.7 2.2 5.7 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.6-.2 5.7-2.2 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.2-3.6-2.2-5.7-5.8-5.8C15.1 2 14.7 2 12 2z',
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <Attribution />
  <Gtm />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content={r.hreflang[0].replace('-', '_')} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(ogW)} />
  <meta property="og:image:height" content={String(Math.round(ogW / (image.ogWidth ? 2.2 : 16 / 9)))} />
  <meta property="og:image:alt" content={image.alt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large" />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <link rel="alternate" type="text/plain" title="LLM summary" href={url('/llms.txt')} />
  <!-- Instant page changes: the browser fetches a page when the visitor hovers or starts tapping its link. -->
  <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] })} />
  <script type="application/ld+json" set:html={JSON.stringify([...org, ...jsonld])} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href={url('/')}>{site.name}</a>
      <nav class="main" aria-label="Main">
        <a href={url(`/${region}/programs/`)}>Programs</a>
        <a href={url(`/${region}/universities/`)}>Universities</a>
        <a href={url('/articles/')}>Guides</a>
      </nav>
      <!-- Region: a compact picker instead of a row of links. On the homepage the Worker sets it from the visitor's country. -->
      <details class="pick rgn">
        <summary aria-label="Change region"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg><span data-geo-name>{r.name}</span></summary>
        <div class="pop region-switch">{regionList.map((x) => <a href={url(`/${x.id}${regionPath || '/'}`)} aria-current={x.id === region ? 'true' : undefined}>{x.label}</a>)}</div>
      </details>
      <a class="btn hdr-cta" href={url(`/${region}/#counselling`)} data-widget="home">Free counselling</a>
      <!-- Mobile menu: plain <details>, so it works without JavaScript. -->
      <details class="pick menu">
        <summary aria-label="Menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
        <div class="pop">
          <a href={url(`/${region}/programs/`)}>Programs</a>
          <a href={url(`/${region}/universities/`)}>Universities</a>
          <a href={url('/articles/')}>Guides</a>
          <a href={url(`/${region}/#counselling`)} data-widget="home">Free counselling</a>
          <span class="social">{site.social.map((x) => <a href={x.href} target="_blank" rel="noopener me" aria-label={`${site.name} on ${x.name}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon[x.name]} /></svg></a>)}</span>
        </div>
      </details>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site">
    <div class="wrap">
      <p><strong>{site.name}</strong> is an independent education counselling service. We help students compare online degree programs and apply to them. We are not a university and do not award degrees. Each degree is awarded by the university that offers it. Check the program details, fees and approvals with the university before you pay.</p>
      <p><a href={url('/about/')}>About</a> · <a href={url('/privacy/')}>Privacy</a> · <a href={url('/articles/')}>Guides</a> · <a href={url('/llms.txt')}>llms.txt</a></p>
      <p class="foot-social">Follow us <span class="social">{site.social.map((x) => <a href={x.href} target="_blank" rel="noopener me" aria-label={`${site.name} on ${x.name}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon[x.name]} /></svg></a>)}</span></p>
    </div>
  </footer>
  <script type="application/json" id="cu-widget-cfg" set:html={JSON.stringify({ region: r.id, whatsapp: r.whatsapp, phone: r.phone, hours: r.hours, endpoint: site.leadEndpoint, chat: site.chatEndpoint })} />
  <script>
    import '../scripts/client';
  </script>
  {site.cfAnalyticsToken && <script is:inline define:vars={{ token: site.cfAnalyticsToken }}>
    // Visitor analytics, loaded once the page has finished loading so it never delays what the visitor sees.
    addEventListener('load', () => (window.requestIdleCallback || setTimeout)(() => {
      const s = document.createElement('script');
      s.defer = true;
      s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      s.dataset.cfBeacon = JSON.stringify({ token, spa: true });
      document.body.appendChild(s);
    }, { timeout: 3000 }));
  </script>}
</body>
</html>
