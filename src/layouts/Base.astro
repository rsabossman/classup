---
import '../styles/global.css';
import { site, url } from '../data/site';
import { regions, regionList, type RegionId } from '../data/regions';
import { heroImg, type Img } from '../data/images';
import Attribution from '../components/Attribution.astro';
import Gtm from '../components/Gtm.astro';
interface Props { title: string; description: string; region?: RegionId; jsonld?: object[]; regionPath?: string; image?: Img }
const { title, description, region = 'in', jsonld = [], regionPath = '', image = heroImg.home } = Astro.props;
const ogW = image.ogWidth ?? 1280;
const ogImage = new URL(url(`/img/${image.name}-${ogW}.webp`), Astro.site).href;
const r = regions[region];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(url('/'), Astro.site).href;
const org = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': home + '#org', name: site.name, url: home, description: site.tagline,
    areaServed: ['IN', 'AE', 'SA', 'QA', 'KW', 'OM', 'BH', 'NG', 'KE', 'GH', 'ZA', 'TZ', 'UG', 'ET', 'ZM'],
    knowsAbout: ['Online degrees in India', 'UGC-entitled online programs', 'Online MBA', 'Online MCA', 'Online BBA', 'Online BCA', 'Online BCom', 'Online MCom', 'Online MA'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': home + '#site', name: site.name, url: home, publisher: { '@id': home + '#org' }, inLanguage: 'en' },
];
// Each regional copy of a page names every country it serves; the international copy is the fallback (x-default).
const alternates = regionPath ? [
  ...regionList.flatMap((x) => x.hreflang.map((h) => ({ hreflang: h, href: new URL(url(`/${x.id}${regionPath}`), Astro.site).href }))),
  { hreflang: 'x-default', href: new URL(url(`/intl${regionPath}`), Astro.site).href },
] : [];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <Attribution />
  <Gtm />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content={r.hreflang[0].replace('-', '_')} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(ogW)} />
  <meta property="og:image:height" content={String(Math.round(ogW / (image.ogWidth ? 2.2 : 16 / 9)))} />
  <meta property="og:image:alt" content={image.alt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large" />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <link rel="alternate" type="text/plain" title="LLM summary" href={url('/llms.txt')} />
  <!-- Instant page changes: the browser fetches a page when the visitor hovers or starts tapping its link. -->
  <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] })} />
  <script type="application/ld+json" set:html={JSON.stringify([...org, ...jsonld])} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href={url(`/${region}/`)}>{site.name}</a>
      <nav class="main" aria-label="Main">
        <a href={url(`/${region}/programs/`)}>Programs</a>
        <a href={url(`/${region}/universities/`)}>Universities</a>
        <a href={url('/articles/')}>Guides</a>
        <a href={url(`/${region}/#counselling`)}>Free counselling</a>
      </nav>
      <div class="region-switch">Region:
        {regionList.map((x) => <a href={url(`/${x.id}${regionPath || '/'}`)} aria-current={x.id === region ? 'true' : undefined}>{x.name}</a>)}
      </div>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site">
    <div class="wrap">
      <p><strong>{site.name}</strong> is an independent education counselling service. We help students compare online degree programs and apply to them. We are not a university and do not award degrees. Each degree is awarded by the university that offers it. Check the program details, fees and approvals with the university before you pay.</p>
      <p><a href={url('/about/')}>About</a> · <a href={url('/privacy/')}>Privacy</a> · <a href={url('/articles/')}>Guides</a> · <a href={url('/llms.txt')}>llms.txt</a></p>
    </div>
  </footer>
  <script type="application/json" id="cu-widget-cfg" set:html={JSON.stringify({ region: r.id, whatsapp: r.whatsapp, phone: r.phone, hours: r.hours, endpoint: site.leadEndpoint, chat: site.chatEndpoint })} />
  <script>
    import '../scripts/client';
  </script>
  {site.cfAnalyticsToken && <script is:inline define:vars={{ token: site.cfAnalyticsToken }}>
    // Visitor analytics, loaded once the page has finished loading so it never delays what the visitor sees.
    addEventListener('load', () => (window.requestIdleCallback || setTimeout)(() => {
      const s = document.createElement('script');
      s.defer = true;
      s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      s.dataset.cfBeacon = JSON.stringify({ token, spa: true });
      document.body.appendChild(s);
    }, { timeout: 3000 }));
  </script>}
</body>
</html>
