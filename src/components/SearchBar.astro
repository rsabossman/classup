---
import { url } from '../data/site';
interface Props { region?: string; suggestions?: string[] }
const { region = 'auto', suggestions = ['Online MBA under 1 lakh', 'MCA without maths', 'BCA after 12th', 'MBA in HR', 'Data science courses', '1 year diploma'] } = Astro.props;
---
<div class="sb" data-search data-region={region} data-index={url('/search-index.json')} data-base={url('/').replace(/\/$/, '')}>
  <form role="search" action={url('/')} method="get">
    <label class="sr" for="sb-q">Search online degree programs</label>
    <svg class="sb-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    <input id="sb-q" name="q" type="search" autocomplete="off" enterkeyhint="search" spellcheck="false"
      placeholder="Ask anything, e.g. online MBA under 1 lakh" aria-describedby="sb-hint" />
    <button class="btn" type="submit">Search</button>
  </form>
  <div class="sb-try" id="sb-hint"><span class="small muted">Try:</span>{suggestions.map((s) => <button type="button" data-try>{s}</button>)}</div>
  <div class="sb-out" data-results hidden></div>
</div>
<style is:global>
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .sb{margin:18px 0 6px;max-width:640px}
  .sb form{position:relative;display:flex;align-items:center;background:#fff;border:1px solid var(--line);border-radius:999px;box-shadow:0 4px 18px rgba(29,34,48,.10);padding:5px 5px 5px 46px}
  .sb form:focus-within{border-color:var(--brand);box-shadow:0 6px 24px rgba(15,92,77,.18)}
  .sb-ic{position:absolute;left:17px;width:20px;height:20px;fill:none;stroke:var(--muted);stroke-width:2.2;stroke-linecap:round}
  .sb input{flex:1;min-width:0;border:0;outline:0;background:transparent;font:inherit;font-size:1.05rem;padding:10px 6px;color:var(--fg)}
  .sb input::-webkit-search-cancel-button{cursor:pointer}
  .sb form .btn{border-radius:999px;padding:11px 20px}
  .sb-try{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:10px}
  .sb-try button{font:inherit;font-size:.85rem;padding:4px 11px;border-radius:99px;border:1px solid var(--line);background:rgba(255,255,255,.9);color:var(--fg);cursor:pointer}
  .sb-try button:hover{border-color:var(--brand);color:var(--brand)}
  .sb-out{margin-top:14px;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 10px 30px rgba(29,34,48,.12);overflow:hidden;text-align:left}
  .sr-answer{padding:14px 16px;background:var(--brand-2);border-bottom:1px solid var(--line)}
  .sr-answer p{margin:0 0 10px;font-size:1rem;color:var(--fg);max-width:none}
  .sr-cta{display:flex;gap:8px;flex-wrap:wrap}.sr-cta .btn{padding:8px 14px;font-size:.92rem}
  .sr-list{list-style:none;margin:0;padding:0}
  .sr-list li+li{border-top:1px solid var(--line)}
  .sr-list a{display:grid;gap:1px;padding:11px 16px;text-decoration:none;color:inherit}
  .sr-list a:hover,.sr-list a:focus{background:#f7f6f2}
  .sr-list b{color:var(--brand);font-size:1rem;line-height:1.3}
  .sr-list .muted{font-size:.9rem}
  .sr-meta{font-size:.9rem}
  .sr-elig{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .sr-more{margin:0;padding:10px 16px;border-top:1px solid var(--line);color:var(--muted)}
  .sr-more:empty{display:none}
  @media(max-width:560px){.sb form{padding-left:40px}.sb-ic{left:14px}.sb form .btn{padding:10px 14px}.sb input{font-size:1rem}}
</style>
<script>
  import '../scripts/search';
</script>
