---
import { uni, feeFor, type Program } from '../data/catalog';
import type { Region } from '../data/regions';
import { url } from '../data/site';
import { imgForDegree } from '../data/images';
import Pic from './Pic.astro';
interface Props { p: Program; region: Region }
const { p, region } = Astro.props;
const u = uni(p);
---
<article class="card media prog" data-degree={p.degree}>
  <a class="stretch" href={url(`/${region.id}/programs/${p.id}/`)}>
    <Pic img={imgForDegree(p.degree)} alt="" sizes="(min-width: 900px) 360px, 100vw" />
    <div class="body" style="padding-bottom:0">
      <h3>{p.name}</h3>
      <div class="muted small">{u.name}</div>
    </div>
  </a>
  <div class="body" style="padding-top:0">
    <p class="small" style="margin:8px 0">
      {p.duration_years ? `${p.duration_years} year${p.duration_years > 1 ? 's' : ''}` : 'Duration on request'}
      {p.credits ? ` · ${p.credits} credits` : ''}
      {' · '}{feeFor(p, region.id)?.short ?? 'Fee on request'}
    </p>
    <div>{u.approvals.slice(0, 2).map((a) => <span class="tag">{a}</span>)}</div>
  </div>
</article>
