---
// Responsive 16:9 WebP illustration. The first image on a page passes priority; everything else lazy-loads.
import { url } from '../data/site';
import { IMG_WIDTHS, type Img } from '../data/images';
interface Props { img: Img; sizes: string; priority?: boolean; class?: string; alt?: string }
const { img, sizes, priority = false, class: cls, alt } = Astro.props;
const src = (w: number) => url(`/img/${img.name}-${w}.webp`);
---
<img
  class={cls}
  src={src(800)}
  srcset={IMG_WIDTHS.map((w) => `${src(w)} ${w}w`).join(', ')}
  sizes={sizes}
  width="1280" height="720"
  alt={alt ?? img.alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
/>
