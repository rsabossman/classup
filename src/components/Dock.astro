---
import type { Region } from '../data/regions';
import LeadForm from './LeadForm.astro';
interface Props { region: Region }
const { region } = Astro.props;
const wa = `https://wa.me/${region.whatsapp}?text=${encodeURIComponent('Hi, I would like to know more about online degree programs.')}`;
---
<div class="dock" aria-label="Contact options">
  <button class="d-chat" type="button" data-open-chat aria-label="Chat with an advisor"><svg viewBox="0 0 24 24"><path d="M4 4h16v12H7l-3 3z"/></svg></button>
  <button class="d-call" type="button" data-open="callme" aria-label="Request a call back"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg></button>
  <a class="d-wa" href={wa} target="_blank" rel="noopener" data-track="whatsapp" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.1.1.6-.1 1.1z"/></svg></a>
</div>
<dialog id="callme">
  <h3 style="margin-top:0">We’ll call you back</h3>
  <p class="small muted">An advisor will call you, usually within a few minutes during {region.hours}.</p>
  <LeadForm region={region.id} intent="callback" compact />
  <form method="dialog"><button class="btn alt" style="margin-top:10px;width:100%">Close</button></form>
</dialog>
